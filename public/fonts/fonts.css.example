@font-face { font-family: 'Pangea'; src: url('/fonts/Pangea-Regular.woff2') format('woff2'); font-weight: 400; font-display: swap; }
@font-face { font-family: 'Pangea'; src: url('/fonts/Pangea-Medium.woff2') format('woff2'); font-weight: 500; font-display: swap; }
@font-face { font-family: 'Pangea'; src: url('/fonts/Pangea-SemiBold.woff2') format('woff2'); font-weight: 600; font-display: swap; }
@font-face { font-family: 'Avenir Next'; src: url('/fonts/AvenirNext-Regular.woff2') format('woff2'); font-weight: 400; font-display: swap; }
@font-face { font-family: 'Avenir Next'; src: url('/fonts/AvenirNext-Medium.woff2') format('woff2'); font-weight: 500; font-display: swap; }
@font-face { font-family: 'Avenir Next'; src: url('/fonts/AvenirNext-DemiBold.woff2') format('woff2'); font-weight: 600; font-display: swap; }
