---
// Shared frame for comparison, guide and decision-guide pages (spec B4).
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AuthorBox from '../components/AuthorBox.astro';
import { articleNode, breadcrumbNode, faqNode } from '../lib/schema';
import { fmtDate } from '../lib/format';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  lede?: string;
  published: Date;
  lastReviewed: Date;
  crumbs: { name: string; path?: string }[];
  toc: { id: string; label: string }[];
  faqs?: { q: string; a: string }[];
}
const { title, description, eyebrow, lede, published, lastReviewed, crumbs, toc, faqs = [] } = Astro.props;
const path = Astro.url.pathname;
const schema = [
  articleNode({ headline: title, description, path, published, modified: lastReviewed }),
  breadcrumbNode(crumbs),
  ...(faqs.length ? [faqNode(faqs)] : []),
];
---
<Base title={title} description={description} schema={schema} ogType="article">
  <div class="container">
    <header class="page-head">
      <Breadcrumbs items={crumbs} />
      <div class="meta-row">
        <span class="eyebrow">{eyebrow}</span>
        <span class="stamp"><time datetime={lastReviewed.toISOString().slice(0, 10)}>Last reviewed: {fmtDate(lastReviewed)}</time></span>
      </div>
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot name="answer" />
      <p class="author-line">By <a href="/about/">Jamie Watts</a>, Managing Director, Mysoft. <a href="#sources">Sources listed below</a>.</p>
    </header>
    <div class="article-layout">
      <div class="article-body">
        <details class="toc-mobile">
          <summary>On this page</summary>
          <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol>
        </details>
        <slot />
        <section aria-labelledby="author-title">
          <h2 id="author-title" class="visually-hidden">About the author</h2>
          <AuthorBox />
        </section>
      </div>
      <nav class="toc" aria-label="On this page">
        <span class="stamp">On this page</span>
        <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ol>
      </nav>
    </div>
  </div>
</Base>
