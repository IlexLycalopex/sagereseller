---
interface Props { items: { name: string; path?: string }[] }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((it, i) =>
      it.path && i < items.length - 1
        ? <li><a href={it.path}>{it.name}</a></li>
        : <li aria-current="page">{it.name}</li>)}
  </ol>
</nav>
