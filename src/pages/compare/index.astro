---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AuthorBand from '../../components/AuthorBand.astro';
import { breadcrumbNode } from '../../lib/schema';
import { fmtDate } from '../../lib/format';

const all = (await getCollection('comparisons')).sort((a, b) => a.data.phase - b.data.phase || a.data.title.localeCompare(b.data.title));
const groups = [
  { product: 'intacct', name: 'Sage Intacct', items: all.filter((c) => c.data.sageProduct === 'intacct') },
  { product: 'x3', name: 'Sage X3', items: all.filter((c) => c.data.sageProduct === 'x3') },
];
---
<Base
  title="Compare Sage with the alternatives"
  description="Side-by-side comparisons of Sage Intacct and Sage X3 with NetSuite, Business Central, Dynamics 365, iplicit and AI-native ledgers, with sources and review dates."
  schema={[breadcrumbNode([{ name: 'Compare', path: '/compare/' }])]}
>
  <div class="container">
    <header class="page-head">
      <Breadcrumbs items={[{ name: 'Compare' }]} />
      <h1>Compare Sage with the alternatives</h1>
      <p class="lede">Fair, sourced comparisons with the systems finance teams most often shortlist alongside Sage. Each one says where the other system is stronger, and when it is the better choice.</p>
      <p class="text-2">Choosing between the two Sage products? Start with <a href="/sage-intacct-or-sage-x3/">Sage Intacct or Sage X3</a>.</p>
    </header>
  </div>
  {groups.map((g) => (
    <section class="section" aria-labelledby={`g-${g.product}`}>
      <div class="container">
        <h2 id={`g-${g.product}`}>{g.name} compared</h2>
        <div class="table-wrap">
          <table class="compare-table">
            <colgroup><col class="c1" /><col class="c2" /><col /><col class="c4" /></colgroup>
            <thead><tr><th scope="col">Compared with</th><th scope="col">Last reviewed</th><th scope="col">Best for</th><th scope="col"><span class="visually-hidden">Link</span></th></tr></thead>
            <tbody>
              {g.items.map((c) => (
                <tr>
                  <th scope="row">{c.data.competitor}<span class="fit-tag">{c.data.competitorVendor}</span></th>
                  <td>{fmtDate(c.data.lastReviewed)}</td>
                  <td class="best">{c.data.bestFor}</td>
                  <td class="action"><a href={`/compare/${c.id}/`} aria-label={`Read comparison: ${c.data.title}`}>Read comparison</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  ))}
  <section class="section">
    <div class="container narrow">
      <h2>How these comparisons are made</h2>
      <div class="prose mt-20">
        <p>We use each vendor's published information and what Mysoft has learned from implementations. We do not publish prices a vendor has not published, and every page lists its sources and the date it was last reviewed. Mysoft is a Sage Partner, so read these with that in mind. <a href="/how-we-compare/">Our editorial policy</a>.</p>
      </div>
    </div>
  </section>
  <AuthorBand />
</Base>
