---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Selector from '../components/Selector.astro';
import AuthorBand from '../components/AuthorBand.astro';
import MysoftLink from '../components/MysoftLink.astro';

const comparisons = (await getCollection('comparisons', (c) => c.data.phase === 1)).sort((a, b) => a.data.title.localeCompare(b.data.title));
const productName = { intacct: 'Sage Intacct', x3: 'Sage X3' } as const;

const faqs = [
  {
    q: 'Sage Intacct or Sage X3: which do we need?',
    a: 'Sage Intacct is cloud financial management with automated multi-entity consolidation, subscription billing and project accounting. Sage X3 runs finance, supply chain and production in one system, with process and discrete manufacturing. Sage Intacct is cloud only; Sage X3 can also run on-premise.',
    href: '/sage-intacct-or-sage-x3/',
    label: 'Read the decision guide',
  },
  {
    q: 'How much does Sage Intacct cost in the UK?',
    a: 'Sage Intacct is quoted rather than sold from a public price list. Quotes are based on the modules you need, the number of users and entities, and the contract term. Implementation is quoted separately by your partner.',
    href: '/guides/sage-intacct-cost-uk/',
    label: 'What drives Sage Intacct cost',
  },
  {
    q: 'Have we outgrown Xero or QuickBooks?',
    a: 'Signals to watch for include a slow month-end close, consolidation in spreadsheets, a second entity or currency, and reporting that depends on one person. Our guide sets out a checklist you can work through with your team.',
    href: '/guides/outgrown-xero-quickbooks/',
    label: 'Signs you have outgrown your system',
  },
  {
    q: 'How do we choose a Sage partner?',
    a: 'Ask for recent projects like yours, speak to two of those customers, and find out who will actually do the work. Compare what is fixed in each proposal, not just the headline price, and ask how support works after go-live.',
    href: '/guides/choosing-a-sage-partner/',
    label: 'Choosing a Sage partner',
  },
];
---
<Base
  title="Find the right Sage system for your finance team"
  fullTitle="The Sage Buyer's Guide: Sage Intacct or Sage X3"
  description="Answer a few short questions to see whether Sage Intacct, Sage X3 or neither fits your business, with the gaps to plan for and what to ask suppliers."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container">
      <h1 id="hero-title">Find the right Sage system for your finance team</h1>
      <p class="lede">Answer a few short questions. Get a straight recommendation, the gaps to plan for, and what to ask any supplier.</p>
      <Selector entry="hero" />
      <p class="hero-foot">Takes about three minutes. Your result appears on screen, no email needed.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="compare-title">
    <div class="container">
      <div class="section-head">
        <h2 id="compare-title">Comparing Sage with another system?</h2>
        <a class="text-link" href="/compare/">All comparisons</a>
      </div>
      <div class="table-wrap">
        <table class="compare-table">
          <caption class="visually-hidden">Comparisons of Sage products with other systems</caption>
          <colgroup><col class="c1" /><col class="c2" /><col /><col class="c4" /></colgroup>
          <thead><tr><th scope="col">Sage product</th><th scope="col">Compared with</th><th scope="col">Best for</th><th scope="col"><span class="visually-hidden">Link</span></th></tr></thead>
          <tbody>
            {comparisons.map((c) => (
              <tr>
                <th scope="row">{productName[c.data.sageProduct]}</th>
                <td>{c.data.competitor}</td>
                <td class="best">{c.data.bestFor}</td>
                <td class="action"><a href={`/compare/${c.id}/`} aria-label={`Read comparison: ${c.data.title}`}>Read comparison</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <h2 id="faq-title">What finance leaders ask first</h2>
      <div class="faq-grid">
        {faqs.map((f) => (
          <div>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
            <a class="text-link" href={f.href}>{f.label}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="addons-title">
    <div class="container">
      <div class="section-head">
        <h2 id="addons-title">Extend Sage with the right add-ons</h2>
        <a class="text-link" href="/marketplace/">The Sage ecosystem</a>
      </div>
      <div class="grid-3">
        <div class="card">
          <span class="card-label">Sage</span>
          <span class="card-name">Sage Intacct Marketplace</span>
          <p class="card-desc">Sage's directory of integrations for Sage Intacct, from more than 350 partners.</p>
          <a class="text-link" href="/marketplace/#intacct-marketplace">What to look for</a>
        </div>
        <div class="card">
          <span class="card-label">Sage</span>
          <span class="card-name">Sage Marketplace (UK)</span>
          <p class="card-desc">Sage's UK listing of apps and add-ons, including extensions for Sage X3.</p>
          <a class="text-link" href="/marketplace/#uk-marketplace">What to look for</a>
        </div>
        <div class="card x3cd">
          <span class="card-label mysoft">Built by Mysoft</span>
          <span class="card-name">X3CloudDocs</span>
          <p class="card-desc">Mysoft's own Sage X3 add-on for purchase invoices, sales orders, documents and notifications.</p>
          <MysoftLink to="mysoft-x3clouddocs" position="addon-card" class="text-link">X3CloudDocs on mysoftx3.com</MysoftLink>
        </div>
      </div>
    </div>
  </section>

  <AuthorBand />
</Base>
